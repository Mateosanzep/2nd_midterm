<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catalog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('navbar') %>
  <main class="catalog">
    <div class="layout-container">
      <header class="catalog-header" style="margin: 20px; margin-left: 5%;">
        <h1 class="section-title">Hero catalog</h1>
        <p class="hero-lead">Browse the roster and jump into any hero’s detailed profile.</p>
      </header>
      <section class="catalog-grid">
        <% if (Array.isArray(heroes) && heroes.length) { %>
          <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            <% heroes.forEach(function(hero) { %>
              <div class="col">
                <article class="card hero-card h-100">
                  <img
                    class="card-img-top <%= hero.isPlaceholder ? 'placeholder-image' : '' %>"
                    src="<%= hero.imageSrc %>"
                    alt="<%= hero.imageAlt %>"
                    loading="lazy"
                  >
                  <div class="card-body">
                    <h5 class="card-title"><%= hero.name %></h5>
                    <p class="card-text">
                      <%= hero.subtitle %>
                    </p>
                    <a href="/heroes/<%= hero.id %>" class="btn hero-cta">View profile</a>
                  </div>
                </article>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state">No heroes available right now. Try again later.</p>
        <% } %>
      </section>
    </div>
  </main>
  <%- include('footer') %>
</body>
</html>
