<nav class="navbar navbar-expand-lg">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Super Heroes</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <div class="container" onclick="toggleMenuIcon(this)">
        <div class="bar1"></div>
        <div class="bar2"></div>
        <div class="bar3"></div>
      </div>
    </button>
    <div class="collapse navbar-collapse w-100" id="navbarSupportedContent">
      <ul class="navbar-nav mx-auto mb-2 mb-lg-0 center-viewport">
        <li class="nav-item">
          <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" aria-current="page" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= currentPath.startsWith('/catalog') || currentPath.startsWith('/heroes') ? 'active' : '' %>" href="/catalog">Catalog</a>
        </li>
      </ul>
      <form class="d-flex ms-auto" role="search" action="/search" method="get">
        <input
          class="form-control me-2 textinput"
          type="search"
          name="q"
          placeholder="Name"
          aria-label="Search by hero name"
          value="<%= (searchQuery || '').trim() %>"
        >
        <button class="btn search-btn" type="submit">Search</button>
      </form>
    </div>
  </div>
</nav>
<script>
  function toggleMenuIcon(element) {
    element.classList.toggle('change');
  }
</script>
